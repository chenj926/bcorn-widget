<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F4F7FB" android:padding="8dp">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="bcorn · 本地课表" android:textColor="#172D44" android:textStyle="bold" android:textSize="14sp" android:maxLines="1"/>
    <TextView android:id="@+id/widget_week" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="日期与时区随本地课表显示" android:textColor="#586B7E" android:textSize="9sp" android:maxLines="2"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ImageView android:id="@+id/widget_grid" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="本周课表，点按打开详情"/>
        <TextView android:id="@+id/widget_placeholder" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="正在读取本地课表…\n若未显示，请点按打开应用" android:textColor="#586B7E" android:textSize="13sp"/>
    </FrameLayout>
    <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="本地数据 · 点按查看详情" android:textColor="#586B7E" android:textSize="10sp" android:maxLines="2"/>
</LinearLayout>
