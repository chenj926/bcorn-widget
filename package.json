{
  "name": "acorn-widget",
  "productName": "ACORN Widget",
  "version": "0.3.0",
  "private": true,
  "description": "今日课表 / 学期课表 / 成绩单的桌面小组件，数据来自 U of T ACORN",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "debug": "ACORN_DEBUG=1 electron . --remote-debugging-port=9229",
    "icon": "node scripts/make-icon.mjs",
    "package": "node scripts/package.mjs",
    "package:install": "node scripts/package.mjs --install",
    "test": "node --test tests/*.test.js",
    "package:windows:reference": "node scripts/package-windows.mjs",
    "tauri:prepare": "node scripts/prepare-tauri.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:bridges": "node --test src-tauri/tests/*.test.cjs android/tests/bridge.test.cjs",
    "test:renderer": "node tests/renderer-smoke.cjs",
    "test:android-renderer": "node android/tests/renderer-smoke.cjs",
    "test:mobile": "node tests/mobile-interactions.cjs",
    "test:compact": "node tests/compact-ui.cjs",
    "test:compact-dom": "node tests/compact-dom.cjs",
    "test:calendar-dom": "node tests/calendar-provider-dom.cjs",
    "test:grades-ui": "node tests/grades-ui.cjs",
    "test:integration": "node tests/compact-dom.cjs && node tests/calendar-provider-dom.cjs && node tests/grades-dom.cjs && node tests/grades-sync-dom.cjs && node tests/cloud-calendar-ui.cjs && node tests/cloud-calendar-races.cjs && node tests/cloud-calendar-app-dom.cjs && node tests/user-backup-dom.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tauri-apps/cli": "^2.12.3",
    "electron": "^44.7.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1"
  }
}
