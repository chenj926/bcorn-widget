{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACORN Widget Lite",
  "version": "0.1.0",
  "identifier": "com.acornwidget.lite",
  "build": {
    "beforeDevCommand": "node scripts/prepare-tauri.mjs",
    "beforeBuildCommand": "node scripts/prepare-tauri.mjs",
    "frontendDist": "../.tauri-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "renderer/index.html",
        "title": "ACORN Widget Lite",
        "width": 420,
        "height": 680,
        "minWidth": 260,
        "minHeight": 280,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "../assets/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
